# 실제 값은 .env 에만. .env 는 절대 커밋하지 않는다.
ENVIRONMENT=development

# 설정하면 /cases (MIMIC 파생) 에 X-API-Key 검사가 걸린다.
# 로컬 개발에서는 비워도 되지만 배포 시 반드시 설정한다.
API_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# RunPod 모델 서버 (ViT / CAM / VQA / Qwen)
RUNPOD_BASE_URL=
RUNPOD_API_KEY=

# RAG
NCBI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM
LLM_BASE_URL=
LLM_API_KEY=
